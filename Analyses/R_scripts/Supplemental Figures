                f[site_class == "synonymous",   uniqueN(key)]))
}

# Rxy from derived allele frequencies
calcL <- function(x, y) {
    den <- sum(y * (1 - x), na.rm = TRUE)
    if (den == 0) return(NA_real_)
    sum(x * (1 - y), na.rm = TRUE) / den
}

calc_Rxy <- function(pop_x, pop_y, freq_dt, del_classes, min_sites = MIN_SITES) {
    shared <- function(classes) {
        dx <- freq_dt[POP == pop_x & site_class %in% classes, .(CHROM, POS, DAF)]
        dy <- freq_dt[POP == pop_y & site_class %in% classes, .(CHROM, POS, DAF)]
        merge(dx, dy, by = c("CHROM", "POS"), suffixes = c("_x", "_y"))
    }
    del <- shared(del_classes); syn <- shared("synonymous")
    if (nrow(del) < min_sites || nrow(syn) < min_sites) return(NA_real_)
    calcL(del$DAF_x, del$DAF_y) / calcL(syn$DAF_x, syn$DAF_y)
}

# chromosome jackknife for Rxy
calc_Rxy_jack <- function(pop_x, pop_y, freq_dt, del_classes, min_sites = MIN_SITES) {
    theta <- calc_Rxy(pop_x, pop_y, freq_dt, del_classes, min_sites)
    shared <- function(classes) {
        dx <- freq_dt[POP == pop_x & site_class %in% classes, .(CHROM, POS, DAF)]
        dy <- freq_dt[POP == pop_y & site_class %in% classes, .(CHROM, POS, DAF)]
        merge(dx, dy, by = c("CHROM", "POS"), suffixes = c("_x", "_y"))
    }
    del <- shared(del_classes); syn <- shared("synonymous")
    empty <- data.table(rxy = NA_real_, se = NA_real_, ci_lo = NA_real_,
                        ci_hi = NA_real_, n_del = nrow(del), n_syn = nrow(syn))
    if (is.na(theta)) return(empty)

    chroms    <- unique(freq_dt$CHROM)
    jack_vals <- vapply(chroms, function(chr)
        calc_Rxy(pop_x, pop_y, freq_dt[CHROM != chr], del_classes, min_sites = 5),
        numeric(1))
    valid <- !is.na(jack_vals)
    if (sum(valid) < 3)
        return(data.table(rxy = theta, se = NA_real_, ci_lo = NA_real_,
                          ci_hi = NA_real_, n_del = nrow(del), n_syn = nrow(syn)))
    n_v    <- sum(valid)
    pseudo <- n_v * theta - (n_v - 1) * jack_vals[valid]
    jk_se  <- sqrt(var(pseudo) / n_v)
    data.table(rxy = theta, se = jk_se,
               ci_lo = theta - 1.96 * jk_se, ci_hi = theta + 1.96 * jk_se,
               n_del = nrow(del), n_syn = nrow(syn))
}

# pairwise Rxy for all population pairs
run_pairwise <- function(freq_dt, del_classes, class_label, metric) {
    pops <- sort(unique(freq_dt$POP))
    rbindlist(lapply(pops, function(px)
        rbindlist(lapply(pops, function(py) {
            r        <- calc_Rxy_jack(px, py, freq_dt, del_classes)
            r$pop_x  <- px; r$pop_y <- py
            r$class  <- class_label; r$metric <- metric
            r
        }))))
}

