# compare per-individual VEP load across imputed genotypes, DS, and GP

# R 4.4.1, data.table 1.18.2.1, ggplot2 3.5.2
library(data.table)
library(ggplot2)

# set pupfish project directory
pupfish_dir <- ""

WORKDIR    <- file.path(pupfish_dir, "load_files.NA")
VEP_DIR    <- file.path(pupfish_dir, "VEP_results")
BURDEN_DIR <- file.path(VEP_DIR, "burden_compare")
POP_FILE   <- file.path(WORKDIR, "pop.txt")
OUTDIR     <- file.path(VEP_DIR, "burden_compare", "summary")
dir.create(OUTDIR, showWarnings = FALSE, recursive = TRUE)

METRICS <- c("imputed", "DS", "GP")
IMPACTS <- c("HIGH", "MODERATE", "LOW", "MODIFIER")

metric_labs <- c(imputed = "Imputed (hard call)",
                 DS       = "Dosage (DS)",
                 GP       = "Raw posterior (GP)")
metric_cols <- c("Imputed (hard call)" = "#1a9641",
                 "Dosage (DS)"         = "#2166ac",
                 "Raw posterior (GP)"  = "#d6604d")

# population assignments
pops <- fread(POP_FILE, header = TRUE)
setnames(pops, 1:2, c("SAMPLE", "POP"))

# read per-sample burden files
load_one <- function(metric, impact) {
    f <- file.path(BURDEN_DIR, metric,
                   sprintf("%s_burden_per_sample.tsv", tolower(impact)))
    if (!file.exists(f)) { message("missing: ", f); return(NULL) }
    dt <- fread(f)
    if (nrow(dt) == 0) return(NULL)
    dt[, IMPACT := impact]
    dt[, metric := metric]
    dt
}
burden <- rbindlist(lapply(METRICS, function(m)
    rbindlist(lapply(IMPACTS, function(i) load_one(m, i)))))
if (nrow(burden) == 0) stop("No burden files found under ", BURDEN_DIR)

burden <- merge(burden, pops, by = "SAMPLE")

# burden rate per called site
burden[, rate := alt_alleles / called_sites]
burden[, IMPACT := factor(IMPACT, levels = IMPACTS)]
burden[, metric := factor(metric, levels = METRICS, labels = metric_labs[METRICS])]

# site coverage per metric and impact
coverage <- burden[, .(median_called_sites = as.numeric(median(called_sites)),
                       min_called = min(called_sites),
                       max_called = max(called_sites),
                       n_individuals = .N),
                   by = .(metric, IMPACT)]
setorder(coverage, IMPACT, metric)
fwrite(coverage, file.path(OUTDIR, "vep_load_site_coverage.csv"))

# population summaries per metric
pop_sum <- burden[, .(
    mean_count = mean(alt_alleles),
    se_count   = sd(alt_alleles) / sqrt(.N),
    mean_rate  = mean(rate),
    se_rate    = sd(rate) / sqrt(.N),
    n_ind      = .N
), by = .(POP, IMPACT, metric)]
setorder(pop_sum, IMPACT, POP, metric)
fwrite(pop_sum, file.path(OUTDIR, "vep_load_by_population_metric.csv"))

# load per population by metric
p_bar <- ggplot(pop_sum, aes(POP, mean_rate, fill = metric)) +
    geom_col(position = position_dodge(0.8), width = 0.75) +
    geom_errorbar(aes(ymin = mean_rate - se_rate, ymax = mean_rate + se_rate),
                  width = 0.2, position = position_dodge(0.8), linewidth = 0.35) +
    facet_wrap(~IMPACT, scales = "free_y", nrow = 1) +
    scale_fill_manual(values = metric_cols, name = "Metric") +
    labs(title    = "VEP load per population, by genotype metric",
         subtitle = "Mean derived/ALT alleles per called site (+/- SE)",
         x = "Population", y = "Burden rate (alleles / called site)") +
    theme_bw(base_size = 12) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1),
          strip.background = element_rect(fill = "grey92"),
          legend.position = "bottom")
ggsave(file.path(OUTDIR, "vep_load_by_population_metric.pdf"), p_bar,
       width = 14, height = 4.5)

# per-individual concordance between metrics
ind_wide <- dcast(burden, SAMPLE + POP + IMPACT ~ metric, value.var = "rate")
mnames <- metric_labs[METRICS]
pairs  <- combn(mnames, 2, simplify = FALSE)

conc <- rbindlist(lapply(pairs, function(p) {
    d <- ind_wide[is.finite(get(p[1])) & is.finite(get(p[2])),
                  .(SAMPLE, POP, IMPACT, x = get(p[1]), y = get(p[2]))]
    if (!nrow(d)) return(NULL)
    d[, comparison := paste(p[1], "vs", p[2])]
    d
}))

p_conc <- ggplot(conc, aes(x, y, colour = IMPACT)) +
    geom_abline(slope = 1, intercept = 0, linetype = "dashed", colour = "grey50") +
    geom_point(size = 1.4, alpha = 0.7) +
    facet_grid(IMPACT ~ comparison, scales = "free") +
    scale_colour_brewer(palette = "Set1", name = "Impact", guide = "none") +
    labs(title    = "Per-individual VEP burden concordance across metrics",
         subtitle = "Each point = one individual. On the dashed line = metrics agree.",
         x = "Burden rate (metric A)", y = "Burden rate (metric B)") +
    theme_bw(base_size = 11) +
    theme(strip.background = element_rect(fill = "grey92"))
ggsave(file.path(OUTDIR, "vep_burden_concordance.pdf"), p_conc,
       width = 10, height = 9)

# concordance summary per metric pair
conc_summary <- conc[, .(
    n            = .N,
    pearson_r    = if (.N > 2 && sd(x) > 0 && sd(y) > 0) cor(x, y) else NA_real_,
    spearman_rho = if (.N > 2) suppressWarnings(cor(x, y, method = "spearman")) else NA_real_,
    mean_absdiff = mean(abs(x - y))
), by = .(comparison, IMPACT)]
setorder(conc_summary, IMPACT, comparison)
fwrite(conc_summary, file.path(OUTDIR, "vep_burden_concordance_summary.csv"))

# population ranking across metrics
rank_dt <- pop_sum[, .(POP, IMPACT, metric, mean_rate)]
ord <- pop_sum[metric == metric_labs["imputed"],
               .(o = mean(mean_rate)), by = POP][order(o), POP]
rank_dt[, POP := factor(POP, levels = ord)]

p_rank <- ggplot(rank_dt, aes(POP, mean_rate, colour = metric, group = metric)) +
    geom_line(linewidth = 0.6) +
    geom_point(size = 2) +
    facet_wrap(~IMPACT, scales = "free_y", nrow = 1) +
    scale_colour_manual(values = metric_cols, name = "Metric") +
    labs(title    = "Population load ranking consistency across metrics",
         subtitle = "Populations ordered by the imputed ranking",
         x = "Population", y = "Mean burden rate") +
    theme_bw(base_size = 12) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1),
          strip.background = element_rect(fill = "grey92"),
          legend.position = "bottom")
ggsave(file.path(OUTDIR, "vep_population_rank_consistency.pdf"), p_rank,
       width = 14, height = 4.5)



