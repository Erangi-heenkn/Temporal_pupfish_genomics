vcfpos[, DERIVED := fcase(REF == ANC, ALT,
                          ALT == ANC, REF,
                          default = NA_character_)]
vcfpos <- vcfpos[!is.na(DERIVED)]
cat(sprintf("Polarised SNPs: %d / %d (%.1f%%)\n",
            nrow(vcfpos), n_snps, 100 * nrow(vcfpos) / n_snps))

# shared site classes from VEP
csq <- fread(CSQ_FILE,
             col.names = c("CHROM", "POS", "REF", "ALT",
                           "Consequence", "IMPACT", "SYMBOL"))

lof_key <- csq[IMPACT == "HIGH", paste(CHROM, POS)]
mis_key <- csq[IMPACT == "MODERATE" & grepl("missense_variant", Consequence),
               paste(CHROM, POS)]
syn_key <- csq[Consequence == "synonymous_variant", paste(CHROM, POS)]

# remove synonymous sites that are also LoF/missense in another transcript
syn_key <- setdiff(syn_key, union(lof_key, mis_key))

cat(sprintf("Site classes -- LoF: %d  missense_del: %d  synonymous: %d\n",
            length(lof_key), length(mis_key), length(syn_key)))

# read per-population frequencies into a table
read_frq <- function(f) {
    pop <- sub("\\.frq$", "", basename(f))
    dt  <- fread(f, skip = 1,
                 col.names = c("CHROM", "POS", "N_ALLELES",
                               "N_CHR", "REF_FREQ", "ALT_FREQ"))
    dt[, POP := pop]
    dt
}

build_freq <- function(frq_dir, metric) {
    files <- list.files(frq_dir, pattern = "\\.frq$", full.names = TRUE)
    if (length(files) == 0) stop("No .frq files in ", frq_dir)
    fa <- rbindlist(lapply(files, read_frq))
    fa <- fa[N_CHR >= MIN_NCHR]
    fa <- merge(fa, vcfpos[, .(CHROM, POS, REF, ALT, DERIVED)],
                by = c("CHROM", "POS"))

    fa[, DAF := ifelse(DERIVED == ALT, ALT_FREQ, 1 - ALT_FREQ)]
    fa[, key := paste(CHROM, POS)]
    fa[, site_class := fcase(key %in% lof_key, "LoF",
                             key %in% mis_key, "missense_del",
                             key %in% syn_key, "synonymous",
                             default = NA_character_)]
    fa <- fa[!is.na(site_class)]
    fa[, metric := metric]
    fa[]
}

