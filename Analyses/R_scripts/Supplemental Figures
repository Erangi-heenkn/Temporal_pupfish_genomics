# Define populations
populations <- c(rep("LR2018", 15), rep("LR2001", 50), rep("MO2001", 20), 
                 rep("MS2019", 15), rep("MS2001", 49), rep("SC17/01", 65))
pop_labels <- unique(populations)
pop_positions <- c(7, 40, 76, 93, 125, 180)
abline_positions <- c(15, 65, 85, 100, 149)

# Define file names and colors for each K
k_values <- 2:6
files <- c("pup_k2.qopt_R3.qopt", "pup_k3.qopt_R4.qopt", "pup_k4.qopt_R5.qopt", 
           "pup_k5.qopt_R7.qopt", "pup_k6.qopt_R5.qopt")
colors_list <- list(
  c("blue", "darkgreen"),
  c("darkgreen", "black", "blue"),
  c("darkgreen", "blue", "black", "lightgreen"),
  c("darkgreen", "blue", "black", "cadetblue3", "lightgreen"),
  c("darkgreen", "blue", "cadetblue3", "black", "lightgreen", "darkgray")
)

# Loop through each K value
for (i in seq_along(k_values)) {
  admix2 <- t(as.matrix(read.table(files[i])))
  
  barplot(admix2, col = colors_list[[i]], space = 0, border = TRUE,
          ylab = paste0("K=", k_values[i]), xaxt = "n")  # Remove x-axis labels
  
  text(pop_positions, -0.1, pop_labels, xpd = TRUE)
  abline(v = abline_positions, lty = 5, lwd = 0.5, col = "white")
}


