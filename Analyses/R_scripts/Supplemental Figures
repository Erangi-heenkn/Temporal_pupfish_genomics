setwd("~/TD")
library("ggplot2")
library(dplyr)

#density plots 

# read data into a data.frame
df <- read.table("LR.TD.txt", header =TRUE)

png(file="LR.TD.png", width = 3550, height = 2000, res = 600)

# Subset the data to include only relevant columns
df_subset <- df[, c('index', 'LR2001', 'LR2018')]
melted_df <- reshape2::melt(df_subset, id.vars = c('index'))

# Calculate mean values for each population
mean_values <- aggregate(value ~ variable, data = melted_df, mean)

# Create a probability density plot with mean lines
ggplot(melted_df, aes(x = value, fill = variable)) +
  geom_density(alpha = 0.7) +
  geom_vline(data = mean_values, aes(xintercept = value, color = variable), linetype = "dashed", size = 0.8, show.legend = FALSE) +
  geom_text(data = mean_values, aes(x = value, y = Inf, label = round(value, 2), color = variable),
            vjust = -1.5, hjust = 0, show.legend = FALSE) + 
  labs(title = "Tajima's D of Lost River",
       x = "Tajima's D",
       y = "Density",
       fill = "Population",
       color = "Population") +
  scale_fill_manual(values = c("LR2001" = "darkgray", "LR2018" = "black")) +
  scale_color_manual(values = c("LR2001" = "darkgray", "LR2018" = "black")) +
  theme_minimal() +
  theme(panel.grid = element_blank(), axis.text = element_text(size = 12),    
        axis.line = element_line(size = 0.5, color = "black"),  
        axis.ticks = element_line(size = 0.5, color = "black"))+
  scale_y_continuous(expand = c(0, 0)) 
dev.off()

