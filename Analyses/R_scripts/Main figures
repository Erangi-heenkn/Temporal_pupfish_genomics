#############################################################################################
#############    (c) of Figure 3 - allele frequency changes over time      ##############

##### The R script for this figure was adapted and modified following the code provided at: 
# https://github.com/pinskylab/codEvol/blob/master/scripts/figures_for_paper.r

############################################################################################

# Set custom colors for each population 
colLR <- 'black'       # Lost River
colSC <- 'darkgreen'   # Salt Creek
colMS <- 'darkblue'    # Malpais Spring

# read in and merge data:  Load allele frequency data for each population at two timepoints
LR2018 <- fread('LR2018.mafs.gz')
LR2001 <- fread('LR2001.mafs.gz')

SC2017 <- fread('SC2017.mafs.gz')
SC2001 <- fread('SC2001.mafs.gz')

MS2019 <- fread('MS2019.mafs.gz')
MS2001 <- fread('MS2001.mafs.gz')

# Merge frequency data by chromosome and position: For each site, freq1 is the recent year, freq2 is the past year
LRdata <- merge(LR2018[, .(chromo, position, freq1 = knownEM)], LR2001[, .(chromo, position, freq2 = knownEM)])
SCdata <- merge(SC2017[, .(chromo, position, freq1 = knownEM)], SC2001[, .(chromo, position, freq2 = knownEM)])
MSdata <- merge(MS2019[, .(chromo, position, freq1 = knownEM)], MS2001[, .(chromo, position, freq2 = knownEM)])

LRdata[, cor(freq1, freq2)]^2
SCdata[, cor(freq1, freq2)]^2
MSdata[, cor(freq1, freq2)]^2

bks <- c(0, 1, 10, 100, 1000, 10000)

LR <- ggplot(LRdata, aes(freq1, freq2)) +
  geom_hex() +
  scale_fill_gradient(low="darkgrey", high=colLR, trans = 'log', breaks = bks, labels = bks) +
  labs(title = 'Lost River', x = 'Allele frequency (2001)', y = 'Allele frequency (2018)') +
  geom_abline(slope = 1, intercept = 0, linetype = 'dashed') + 
  theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
        panel.background = element_blank(), axis.line = element_line(colour = "black"),
        legend.position = 'none') +
  coord_cartesian(xlim =c(0, 1), ylim = c(0, 1))+ annotate("text", x = 0.2, y = 0.95, label = paste("R² =0.801"), color = "black", size = 3)

SC <- ggplot(SCdata, aes(freq1, freq2)) +
  geom_hex() +
  scale_fill_gradient(low="lightgreen", high=colSC, trans = 'log', breaks = bks, labels = bks) +
  labs(title = 'Salt Creek', x = 'Allele frequency (2001)', y = 'Allele frequency (2017)') +
  geom_abline(slope = 1, intercept = 0, linetype = 'dashed') + 
  theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
        panel.background = element_blank(), axis.line = element_line(colour = "black"),
        legend.position = 'none') +
  coord_cartesian(xlim =c(0, 1), ylim = c(0, 1))+ annotate("text", x = 0.2, y = 0.95, label = paste("R² = 0.774"), color = "black", size = 3)

MS <- ggplot(MSdata, aes(freq1, freq2)) +
  geom_hex() +
  scale_fill_gradient(low="skyblue", high=colMS, trans = 'log', breaks = bks, labels = bks) +
  labs(title =  'Malpais Spring', x = 'Allele frequency (2001)', y = 'Allele frequency (2019)') +
  geom_abline(slope = 1, intercept = 0, linetype = 'dashed') + 
  theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
        panel.background = element_blank(), axis.line = element_line(colour = "black"),
        legend.position = 'none') +
  coord_cartesian(xlim =c(0, 1), ylim = c(0, 1))+ annotate("text", x = 0.2, y = 0.95, label = paste("R² = 0.900"), color = "black", size =3)


P3 <- grid.arrange(LR, SC, MS,ncol = 3)

