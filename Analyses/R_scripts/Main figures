#######  (d) of Figure 3 - effective population size-Ne   #####
###############################################################

data <- data.frame(
  Population = rep(c("MS", "SC", "LR", "MO"), c(3, 3, 3, 1)),  # MO only has one timepoint
  Timepoint = c("2001", "2019", "Temporal",  
                "2001", "2017", "Temporal",  
                "2001", "2018", "Temporal",  
                "2001"),  # MO 2001
  Ne = c(385.7, 879.85,525.5, 174.5, 144.2, 216.6, 135.4, 198.3 , 291.3, 192.7),  # Added MO 2001 estimate
  Lower_CI = c(350.3, 44.1,473.6,125, 77,191, 120.8,114.7,264.4,160),  
  Upper_CI = c(428.8, 2274,590.3,278.9, 840.9,250.1,153.6, 675, 324.2,241.5),  
  Method = c("LD-based", "LD-based", "Temporal",  
             "LD-based", "LD-based", "Temporal",  
             "LD-based", "LD-based", "Temporal",  
             "LD-based")  # MO 2001 is a Timepoint
)
# Create x-axis labels with correct ordering
data$Pop_Time <- factor(paste(data$Population, data$Timepoint),
                        levels = c("MS 2001", "MS 2019", "MS Temporal",  
                                   "SC 2001", "SC 2017", "SC Temporal",  
                                   "LR 2001", "LR 2018", "LR Temporal",  
                                   "MO 2001"))  # MO added at the end

# Custom colors
color_map <- c("MS" = "blue", "SC" = "green4", "LR" = "black", "MO" = "coral2")

# Plot

P4<-ggplot(data, aes(x = Pop_Time, y = Ne, color = Population, group = Population)) +
  geom_point(aes(shape = Method), size = 3, alpha=0.5) +  # Different shapes for timepoints vs. temporal
  geom_errorbar(aes(ymin = Lower_CI, ymax = Upper_CI), width = 0.15, lwd=0.4) +  
  scale_x_discrete(expand = expansion(mult = c(0.1, 0.1))) +  
  scale_y_continuous(limits = c(0, 2275)) +  # Limit y-axis
  scale_color_manual(values = color_map,guide = "none")+
  scale_shape_manual(values = c(16, 18)) + 
  labs(y = expression("Effective Population Size (Ne)"), x = NULL)  +
  theme_minimal() +   theme(
    legend.position = c(0.60, 1.04),
    legend.direction = "vertical",
    legend.justification = c("top"),
    legend.key.height = unit(0.5, "cm"),
    legend.key.width = unit(0.4, "cm"), 
   legend.background = element_rect(fill = "white", color = "black", linewidth = 0.2),
    legend.text = element_text(size = 7, margin = margin(r = 0.5))  # spacing between text items
 )+theme(
    legend.title = element_text(size = 9)  # Adjust size as needed
  )+
  theme( 
        panel.grid.minor = element_blank(),  
        panel.grid.major = element_blank(),  # Remove grid
        axis.line = element_line(colour = "black"),
        axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1, size = 6) 
        )  

